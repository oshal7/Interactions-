{
  "name": "Paper Sky",
  "short_name": "Paper Sky",
  "description": "Paper planes drifting on slow air currents. Move your finger and they follow; hold still and they circle you.",
  "start_url": "./?mode=interactive&app=1&clock=1&dpr=2",
  "scope": "./",
  "display": "fullscreen",
  "display_override": ["fullscreen", "standalone"],
  "orientation": "any",
  "background_color": "#232a45",
  "theme_color": "#232a45",
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ]
}
